{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:konstellation:schema:exploration-state:0.2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "query",
    "lensRef",
    "view",
    "selectedEntityId",
    "openPanels",
    "layout"
  ],
  "properties": {
    "schemaVersion": {
      "const": "0.2"
    },
    "query": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "context",
        "selection",
        "order",
        "pageSize"
      ],
      "properties": {
        "schemaVersion": {
          "const": "0.2"
        },
        "context": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "datasetRef",
            "registryRef",
            "readerPolicyRef",
            "executionProfileRef"
          ],
          "properties": {
            "datasetRef": {
              "type": "string",
              "minLength": 1
            },
            "registryRef": {
              "type": "string",
              "minLength": 1
            },
            "readerPolicyRef": {
              "type": "string",
              "minLength": 1
            },
            "executionProfileRef": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "selection": {
          "$ref": "#/$defs/selection"
        },
        "order": {
          "const": "entity_id_asc"
        },
        "pageSize": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      }
    },
    "lensRef": {
      "type": "string",
      "minLength": 1
    },
    "view": {
      "enum": [
        "list",
        "table",
        "graph",
        "constellation"
      ]
    },
    "selectedEntityId": {
      "type": [
        "string",
        "null"
      ]
    },
    "openPanels": {
      "type": "array",
      "items": {
        "enum": [
          "filters",
          "query",
          "evidence"
        ]
      },
      "minItems": 0,
      "maxItems": 3,
      "uniqueItems": true
    },
    "layout": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "entityId",
          "x",
          "y"
        ],
        "properties": {
          "entityId": {
            "type": "string",
            "pattern": "^[a-zA-Z][a-zA-Z0-9_.:-]*$"
          },
          "x": {
            "type": "number"
          },
          "y": {
            "type": "number"
          }
        }
      },
      "minItems": 0,
      "maxItems": 500
    },
    "constellation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "satelliteLimit",
        "path"
      ],
      "properties": {
        "satelliteLimit": {
          "type": "integer",
          "minimum": 3,
          "maximum": 25
        },
        "path": {
          "type": "array",
          "minItems": 0,
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "focus",
              "groupId",
              "label"
            ],
            "properties": {
              "focus": {
                "oneOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "kind",
                      "id"
                    ],
                    "properties": {
                      "kind": {
                        "const": "entity"
                      },
                      "id": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 1000
                      }
                    }
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "kind",
                      "id"
                    ],
                    "properties": {
                      "kind": {
                        "const": "source"
                      },
                      "id": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 1000
                      }
                    }
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "kind",
                      "predicate",
                      "key"
                    ],
                    "properties": {
                      "kind": {
                        "const": "qualifier"
                      },
                      "predicate": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 500
                      },
                      "key": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 2048
                      }
                    }
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "kind",
                      "relation",
                      "key"
                    ],
                    "properties": {
                      "kind": {
                        "const": "relation-value"
                      },
                      "relation": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 500
                      },
                      "key": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 2048
                      }
                    }
                  }
                ]
              },
              "groupId": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 300
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "term": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "id"
          ],
          "properties": {
            "kind": {
              "const": "entity"
            },
            "id": {
              "type": "string",
              "pattern": "^[a-zA-Z][a-zA-Z0-9_.:-]*$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "string"
            },
            "value": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "integer"
            },
            "value": {
              "type": "integer"
            }
          }
        }
      ]
    },
    "filter": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "relation",
            "op"
          ],
          "properties": {
            "relation": {
              "type": "string",
              "pattern": "^[a-zA-Z][a-zA-Z0-9_.:-]*$"
            },
            "op": {
              "const": "exists"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "relation",
            "op"
          ],
          "properties": {
            "relation": {
              "type": "string",
              "pattern": "^[a-zA-Z][a-zA-Z0-9_.:-]*$"
            },
            "op": {
              "const": "missing_in_view"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "relation",
            "op",
            "values"
          ],
          "properties": {
            "relation": {
              "type": "string",
              "pattern": "^[a-zA-Z][a-zA-Z0-9_.:-]*$"
            },
            "op": {
              "const": "in"
            },
            "values": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/term"
              },
              "minItems": 1,
              "maxItems": 100,
              "uniqueItems": true
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "relation",
            "op",
            "values"
          ],
          "properties": {
            "relation": {
              "type": "string",
              "pattern": "^[a-zA-Z][a-zA-Z0-9_.:-]*$"
            },
            "op": {
              "const": "none_of"
            },
            "values": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/term"
              },
              "minItems": 1,
              "maxItems": 100,
              "uniqueItems": true
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "relation",
            "op",
            "interval",
            "match"
          ],
          "properties": {
            "relation": {
              "type": "string",
              "pattern": "^[a-zA-Z][a-zA-Z0-9_.:-]*$"
            },
            "op": {
              "const": "overlaps"
            },
            "interval": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "from",
                "to",
                "calendar"
              ],
              "properties": {
                "from": {
                  "type": "integer"
                },
                "to": {
                  "type": "integer"
                },
                "calendar": {
                  "const": "proleptic-gregorian-astronomical"
                }
              }
            },
            "match": {
              "const": "definite"
            }
          }
        }
      ]
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entityType",
        "filters",
        "links"
      ],
      "properties": {
        "entityType": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9_.:-]*$"
        },
        "ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-zA-Z][a-zA-Z0-9_.:-]*$"
          },
          "minItems": 1,
          "maxItems": 100,
          "uniqueItems": true
        },
        "filters": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/filter"
          },
          "minItems": 0,
          "maxItems": 32
        },
        "links": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/link"
          },
          "minItems": 0,
          "maxItems": 16
        }
      }
    },
    "link": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relation",
        "target"
      ],
      "properties": {
        "relation": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9_.:-]*$"
        },
        "target": {
          "$ref": "#/$defs/selection"
        }
      }
    }
  }
}
