{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:konstellation:schema:query-spec:1.0",
  "title": "Konstellation QuerySpec",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "root", "filters"],
  "properties": {
    "version": { "const": "1.0" },
    "root": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "type": "string", "minLength": 1 },
        "entity": { "type": ["string", "null"] }
      }
    },
    "filters": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["relation", "operator"],
        "properties": {
          "id": { "type": "string" },
          "relation": { "type": "string", "minLength": 1 },
          "operator": { "type": "string", "minLength": 1 },
          "value": {},
          "values": { "type": "array" },
          "from": { "type": ["number", "integer", "string", "null"] },
          "to": { "type": ["number", "integer", "string", "null"] }
        },
        "additionalProperties": true
      }
    },
    "sort": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["key", "direction"],
        "properties": {
          "key": { "type": "string" },
          "direction": { "enum": ["asc", "desc"] }
        },
        "additionalProperties": false
      }
    },
    "page": {
      "type": "object",
      "properties": {
        "limit": { "type": "integer", "minimum": 1, "maximum": 500 },
        "cursor": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    }
  }
}
