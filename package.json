{
  "name": "konstellation",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "astro build",
    "start": "node server/index.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "playwright test",
    "check": "npm test && npm run test:ui && npm run build",
    "pack:validate": "node scripts/pack.mjs validate",
    "pack:import": "node scripts/import-kristal.mjs",
    "test:ui": "vitest run"
  },
  "dependencies": {
    "@astrojs/svelte": "9.0.1",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "astro": "7.3.5",
    "hyparquet": "1.31.1",
    "hyparquet-compressors": "1.1.2",
    "svelte": "5.57.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@testing-library/svelte": "5.4.2",
    "hyparquet-writer": "0.16.10",
    "jsdom": "26.1.0",
    "prettier": "3.9.9",
    "prettier-plugin-svelte": "4.1.1",
    "vitest": "5.0.2"
  }
}
